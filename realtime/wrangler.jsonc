{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "barrapad-realtime",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    // Binding name "Main" keeps the PartyKit URL shape: /parties/main/<room>
    "bindings": [{ "name": "Main", "class_name": "NoteParty" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteParty"] }],
  "observability": { "enabled": true },
  // No cron: a keep-warm ping kept the Neon compute running (and billed) around the clock.
  // An empty list removes the schedule from Cloudflare; omitting the key would leave it.
  "triggers": { "crons": [] }
}
