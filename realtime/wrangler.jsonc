{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "barrapad-realtime",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    // Binding name "Main" keeps the PartyKit URL shape: /parties/main/<room>
    "bindings": [{ "name": "Main", "class_name": "NoteParty" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteParty"] }],
  "observability": { "enabled": true },
  // Keep the Neon database awake: ping the app's health route every 4 minutes.
  "triggers": { "crons": ["*/4 * * * *"] },
  "vars": { "APP_URL": "https://www.bpad.cc" }
}
